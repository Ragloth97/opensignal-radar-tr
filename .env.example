# OpenSignal Radar TR — Çevre Değişkenleri
# Bu dosyayı .env olarak kopyalayın

# Veritabanı
DATABASE_URL=sqlite:///./data/opensignal.db
# PostgreSQL'e geçiş için:
# DATABASE_URL=postgresql://user:password@localhost:5432/opensignal

# Zamanlama (saat cinsinden)
INGESTION_INTERVAL_HOURS=2.0
SIGNAL_PROCESSING_INTERVAL_HOURS=2.5
TREND_CLUSTER_INTERVAL_HOURS=6.0

# Ollama (opsiyonel)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Loglama
LOG_LEVEL=INFO
# LOG_FILE=./data/logs/opensignal.log

# Sinyal eşikleri
MIN_SIGNAL_SCORE=0.20
HIGH_CONFIDENCE_THRESHOLD=0.70
HIGH_IMPACT_THRESHOLD=0.70
